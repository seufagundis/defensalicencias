<body
    class="bg-background-light dark:bg-background-dark font-display text-primary dark:text-gray-100 transition-colors duration-300 overflow-x-hidden">

    <!-- Header Section -->
    <%- include("partials/header") %>

        <main class="flex flex-col items-center">
            <!-- Hero Section -->
            <section class="w-full max-w-[1440px] px-0 sm:px-4 md:px-10 lg:px-40 pt-0 pb-6 sm:py-10 lg:py-16">
                <div
                    class="relative overflow-hidden rounded-none sm:rounded-xl bg-primary min-h-[420px] sm:min-h-[520px] flex items-center">

                    <!-- Background pattern -->
                    <div class="absolute inset-0 opacity-10 pointer-events-none"
                        style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;">
                    </div>

                    <!-- Content -->
                    <div class="relative z-10 px-5 sm:px-8 md:px-16 lg:w-3/4 flex flex-col gap-6 sm:gap-8 py-8 sm:py-0">

                        <div
                            class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 w-fit">
                            <span class="flex h-2 w-2 rounded-full bg-accent-yellow"></span>
                            <span class="text-white/80 text-xs font-bold tracking-wider uppercase">
                                Soluciones Legales
                            </span>
                        </div>

                        <h1 class="text-white text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black leading-tight">
                            ¿No podés renovar tu <br />
                            <span class="text-accent-yellow">licencia por multas?</span>
                        </h1>

                        <p class="text-white/70 text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed">
                            Resolvemos la liberación de tu registro de conducir de forma legal y rápida en Provincia de
                            Buenos Aires.
                        </p>

                        <div class="flex flex-col sm:flex-row gap-4 mt-2 sm:mt-4">
                            <a href="<%= whatsappLink %>" target="_blank" rel="noopener"
                                class="inline-flex items-center justify-center bg-accent text-primary font-bold py-3 px-6 sm:px-8 rounded-full hover:opacity-90 transition-all">
                                Comenzar Trámite Gratis
                            </a>

                            <a href="/derechos" class="inline-flex items-center justify-center
          bg-white/10 hover:bg-white/20
          text-white px-6 sm:px-8 py-3 sm:py-4 rounded-lg
          text-base font-bold transition-all
          border border-white/10">
                                Ver Cobertura
                            </a>
                        </div>

                    </div>

                    <!-- Decorative shape -->
                    <div class="absolute right-0 bottom-0 top-0 w-1/4 hidden lg:block bg-accent-yellow opacity-10"
                        style="clip-path: polygon(100% 0, 0 100%, 100% 100%);"></div>

                </div>
            </section>
            <!-- Features Section -->
            <section class="w-full max-w-[1440px] px-4 md:px-10 lg:px-40 py-16 bg-white dark:bg-background-dark/50">
                <div class="flex flex-col gap-12">
                    <div
                        class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-l-4 border-accent-yellow pl-6">
                        <div class="flex flex-col gap-2">
                            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-primary dark:text-white">
                                Asesoramiento Especializado</h2>
                            <p class="text-gray-500 dark:text-gray-400 text-lg">Especialistas en la defensa de tus
                                derechos.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Feature 1 -->
                        <!-- Card 1 -->
                        <div
                            class="p-8 rounded-xl bg-background-light dark:bg-primary/40 border border-accent-yellow/40">
                            <div
                                class="bg-primary dark:bg-accent-yellow/10 w-14 h-14 rounded-lg flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined text-accent-yellow text-3xl">verified_user</span>
                            </div>
                            <h3 class="text-xl font-bold mb-4 text-primary dark:text-white">
                                Nuestro objetivo
                            </h3>
                            <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-3">
                                Analizamos tu caso y gestionamos una acción judicial para que puedas renovar tu licencia
                                sin que el pago previo de multas cuestionadas funcione como un impedimento automático.
                            </p>
                            <ul class="text-gray-500 dark:text-gray-400 space-y-1 text-sm">
                                <li>✔ Permitir la renovación de tu licencia</li>
                                <li>✔ Evitar bloqueos administrativos indebidos</li>
                                <li>✔ Garantizar tu derecho a circular y trabajar</li>
                            </ul>
                        </div>
                        <!-- Feature 2 -->
                        <div
                            class="group p-8 rounded-xl bg-background-light dark:bg-primary/40 border border-gray-200 dark:border-white/5 hover:border-accent-yellow/50 transition-all hover:shadow-xl">
                            <div
                                class="bg-primary dark:bg-accent-yellow/10 w-14 h-14 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-accent-yellow text-3xl">distance</span>
                            </div>
                            <h3 class="text-xl font-bold mb-3 text-primary dark:text-white">Cobertura en PBA</h3>
                            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                                Operamos con éxito en todos los municipios de la Provincia
                                de
                                Buenos Aires. Por el momento no brindamos asesoramiento en otras jurisdicciones.
                            </p>
                        </div>
                        <!-- Feature 3 -->
                        <div
                            class="group p-8 rounded-xl bg-background-light dark:bg-primary/40 border border-gray-200 dark:border-white/5 hover:border-accent-yellow/50 transition-all hover:shadow-xl">
                            <div
                                class="bg-primary dark:bg-accent-yellow/10 w-14 h-14 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-accent-yellow text-3xl">gavel</span>
                            </div>
                            <h3 class="text-xl font-bold mb-3 text-primary dark:text-white">Respaldo Legal</h3>
                            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                                Representación directa por abogados especialistas en derecho administrativo. Seguridad
                                jurídica en cada paso del proceso.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Timeline Section -->
            <section class="w-full max-w-[1440px] px-4 md:px-10 lg:px-40 py-20">
                <div class="bg-primary rounded-2xl p-10 md:p-16 flex flex-col md:flex-row gap-12 items-center">
                    <div class="flex-1 space-y-6">
                        <h2 class="text-white text-3xl md:text-4xl font-extrabold">Cómo funciona el proceso</h2>
                        <p class="text-white/60 text-lg">Un camino simple, legal y sin vueltas para recuperar tu derecho
                            a
                            conducir.</p>
                        <div class="pt-4">
                            <a href="<%= whatsappLink %>" target="_blank" rel="noopener"
                                class="inline-flex items-center justify-center bg-accent text-primary font-bold py-4 px-10 rounded-full hover:opacity-90 transition-all">
                                Iniciar mi consulta
                            </a>
                        </div>
                    </div>
                    <div class="flex-1 w-full space-y-0">
                        <!-- Step 1 -->
                        <div class="flex gap-6 group">
                            <div class="flex flex-col items-center">
                                <div
                                    class="w-10 h-10 rounded-full bg-accent-yellow text-primary flex items-center justify-center font-bold z-10 shrink-0">
                                    1</div>
                                <div class="w-0.5 h-full bg-white/10 group-last:bg-transparent"></div>
                            </div>
                            <div class="pb-10 pt-1">
                                <h4 class="text-white text-lg font-bold mb-1">Envía tu consulta</h4>
                                <p class="text-white/50">Comunicate vía WhatsApp con tus datos
                                    básicos.</p>
                            </div>
                        </div>
                        <!-- Step 2 -->
                        <div class="flex gap-6 group">
                            <div class="flex flex-col items-center">
                                <div
                                    class="w-10 h-10 rounded-full bg-accent-yellow text-primary flex items-center justify-center font-bold z-10 shrink-0">
                                    2</div>
                                <div class="w-0.5 h-full bg-white/10 group-last:bg-transparent"></div>
                            </div>
                            <div class="pb-10 pt-1">
                                <h4 class="text-white text-lg font-bold mb-1">Nos contactamos a la brevedad</h4>
                                <p class="text-white/50">Revisaremos tu caso y nos pondremos en contacto para informarte
                                    sobre nuestro servicio y resolver tus dudas.</p>
                            </div>
                        </div>
                        <!-- Step 3 -->
                        <div class="flex gap-6 group">
                            <div class="flex flex-col items-center">
                                <div
                                    class="w-10 h-10 rounded-full bg-accent-yellow text-primary flex items-center justify-center font-bold z-10 shrink-0">
                                    3</div>
                                <div class="w-0.5 h-0 bg-white/10 group-last:bg-transparent"></div>
                            </div>
                            <div class="pb-4 pt-1">
                                <h4 class="text-white text-lg font-bold mb-1">Liberamos tu Licencia</h4>
                                <p class="text-white/50">Realizamos las presentaciones legales necesarias para que
                                    puedas renovar sin
                                    pagar
                                    multas improcedentes.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- CTA / Trust Section -->
            <section class="w-full max-w-[1440px] px-4 md:px-10 lg:px-40 py-16 text-center">
                <div class="bg-accent-yellow/10 border border-accent-yellow/20 rounded-xl p-8 md:p-12">
                    <span class="material-symbols-outlined text-accent-yellow text-5xl mb-4">verified_user</span>
                    <h2 class="text-2xl md:text-3xl font-black mb-4"> </h2>
                    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-8 text-lg">
                        No te quedes sin tu licencia por multas. La ley te ampara y nosotros hacemos valer tus derechos
                        ante
                        la justicia.
                    </p>
                    <div
                        class="flex flex-wrap justify-center gap-10 opacity-60 grayscale brightness-50 dark:brightness-150">

                        <div class="h-8 flex items-center font-black text-xl italic tracking-tighter">PBA</div>

                    </div>
                </div>
            </section>
        </main>
        <!-- Footer -->
        <%- include("partials/footer") %>
            <!-- Floating WhatsApp Button -->
            <%- include("partials/floating-whatsapp") %>

</body>

</html>